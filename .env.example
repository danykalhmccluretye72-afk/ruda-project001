# Обычно этот файл создаёт scripts/setup-server.sh автоматически.
POSTGRES_PASSWORD=смените-на-длинный-пароль

# Секрет для подписи сессий (openssl rand -base64 32)
BETTER_AUTH_SECRET=смените-на-случайную-строку

# Адрес, по которому пользователи открывают сайт: https://домен или http://IP
BETTER_AUTH_URL=http://127.0.0.1

# Домен для автоматического HTTPS (Let's Encrypt). Без домена — :80 (доступ по IP, без HTTPS)
DOMAIN=:80

# caddy — встроенный веб-сервер на 80/443; пусто — внешний nginx проксирует на 127.0.0.1:3000
COMPOSE_PROFILES=caddy

# Для внешней БД раскомментируйте:
# DATABASE_URL=postgres://user:password@host:6432/db?sslmode=verify-full
