# Скопируйте в .env и заполните
POSTGRES_PASSWORD=смените-на-длинный-пароль

# Домен для автоматического HTTPS (Let's Encrypt). Без домена — оставьте :80 (доступ по IP, без HTTPS)
DOMAIN=:80

# Для внешней БД (например, Yandex Managed PostgreSQL) раскомментируйте:
# DATABASE_URL=postgres://user:password@host:6432/db?sslmode=verify-full&sslrootcert=/app/root.crt
